# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///data/vulnerabilities.db

# Jira Configuration
JIRA_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=VULN

# API Keys for Vulnerability Sources
WIZ_API_KEY=your-wiz-api-key
WIZ_API_URL=https://api.wiz.io
VERACODE_API_ID=your-veracode-api-id
VERACODE_API_KEY=your-veracode-api-key
ARCTIC_WOLF_API_KEY=your-arctic-wolf-api-key
CROWDSTRIKE_CLIENT_ID=your-crowdstrike-client-id
CROWDSTRIKE_CLIENT_SECRET=your-crowdstrike-client-secret
BURP_API_KEY=your-burp-api-key

# Application Settings
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-production
